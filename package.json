{
    "name": "pokemon-emerald-ex-dex",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "engines": {
        "node": ">=22.18 <27",
        "npm": ">=10"
    },
    "scripts": {
        "dev": "npm run dev -w apps/server",
        "dev:server": "npm run dev -w apps/server",
        "dev:client": "npm run dev -w apps/client",
        "build": "npm run build -w packages/shared && npm run build -w apps/server && npm run build -w apps/client",
        "start": "npm run start -w apps/server",
        "test": "npm test --workspaces --if-present",
        "typecheck": "npm run build -w packages/shared && npm run typecheck --workspaces --if-present",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:tailwind": "tailwint",
        "lint:tailwind:fix": "tailwint --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "check": "npm run typecheck && npm run lint && npm run lint:tailwind && npm test && npm run format:check",
        "clean": "node -e \"for (const p of ['dist','apps/server/dist','apps/client/dist','packages/shared/dist']) fs.rmSync(p, { recursive: true, force: true })\"",
        "clean:modules": "node -e \"fs.rmSync('node_modules', { recursive: true, force: true })\"",
        "clean:lock": "node -e \"fs.rmSync('package-lock.json', { force: true })\"",
        "reinstall": "npm run clean:modules && npm ci",
        "reset:deps": "npm run clean:modules && npm run clean:lock && npm install"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@tailwindcss/language-server": "0.16.0",
        "@types/node": "22.20.4",
        "eslint": "10.11.0",
        "globals": "17.12.0",
        "prettier": "3.9.9",
        "tailwint": "1.1.16",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1"
    },
    "allowScripts": {
        "esbuild": true
    }
}
