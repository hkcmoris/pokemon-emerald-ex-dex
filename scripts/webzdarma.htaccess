AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType image/x-icon .ico
AddType application/xml .xml

RewriteEngine On
# Deny hidden files and directories without changing hosting-wide Options settings.
RewriteRule (^|/)\. - [F,L]
# Deny directory listings below the app root; index.html is served by the host default.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule . - [F,L]
