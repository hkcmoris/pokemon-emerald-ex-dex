PORT=3000
LOG_LEVEL=info

# Use .env.local for local development; production ignores .env.local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emerald_ex_dev
DB_USER=root
DB_PASS=
DEX_DATASET_ID=emerald-ex-1.0.4

# Vite development/preview proxy target (server-side only, no DB credentials).
DEV_API_TARGET=http://127.0.0.1:3000

# Optional PHP 8.4 executable for local PHP preview and PHP database tests.
PHP_BINARY=php
