PORT=3000
LOG_LEVEL=info

# Use .env.local for local development; production ignores .env.local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emerald_ex_dev
DB_USER=root
DB_PASS=
DEX_DATASET_ID=emerald-ex-1.0.4

# Vite development/preview proxy target (server-side only, no DB credentials).
DEV_API_TARGET=http://127.0.0.1:3000

# Optional PHP 8.4 executable for local PHP preview and PHP database tests.
PHP_BINARY=php

# Google is only the sign-in provider. Collections are stored in this app's MySQL database.
# Create a Google OAuth Web client with your exact browser origins (no path suffix).
GOOGLE_CLIENT_ID=
# Local development only. Production uses https://devground.cz (no path or trailing slash).
COLLECTION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3001
# Local HTTP only. Use true with HTTPS in production.
COLLECTION_COOKIE_SECURE=false
